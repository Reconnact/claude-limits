#!/bin/bash
# Reads all three limits, the Fable one included, from the usage endpoint Claude Code calls for /usage
# and hands them to collect; the limit resets you hold go to <user>-resets.js. Undocumented: an empty or changed answer writes nothing.
DIR="${CLAUDE_LIMITS_DIR:-/Users/Shared/claude-limits}"
# Claude Code keeps its login under the macOS account; another entry of the same name may hold only MCP servers' state (#20)
token() { security find-generic-password -s "Claude Code-credentials" "$@" -w 2>/dev/null | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null; }
TOKEN="$(token -a "$(id -un)")"
[ -n "$TOKEN" ] || TOKEN="$(token)"
[ -n "$TOKEN" ] || exit 0
# the resets are listed only to Claude Code's user agent with an installed version, else "surface" or "cli_version"
VERSION="$(claude --version 2>/dev/null)"
VERSION="${VERSION%% *}"

# the header goes in on stdin, so the token never shows in ps
{ IFS= read -r LIMITS; IFS= read -r RESETS; } < <(printf 'header = "Authorization: Bearer %s"\n' "$TOKEN" \
  | curl -s -f -m 10 -K - ${VERSION:+-A "claude-cli/$VERSION (external, cli)"} -H "anthropic-beta: oauth-2025-04-20" "https://api.anthropic.com/api/oauth/usage?cedar_ember=1" \
  | jq -c --arg source "$(id -un)" '
      def epoch: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601;
      def window($pct; $reset): if $pct == null or $reset == null then null else {used_percentage: $pct, resets_at: ($reset | epoch)} end;
      # as Claude Code names a reset: by its type, else by the limits it clears
      def kind:
        if .gives_back_weekly == true then "fable"
        elif (.type | IN("session", "weekly", "full")) then .type
        else (.clears // []) as $c | ($c | index("five_hour") != null) as $h | ($c | any(. != "five_hour")) as $w
          | if $h and ($w | not) then "session" elif $w and ($h | not) then "weekly" else "full" end end;
      (first(.limits[]? | select(.kind == "weekly_scoped" and .scope.model.display_name == "Fable")) // null) as $f
      | {fresh: true, rate_limits: {
          five_hour: window(.five_hour.utilization; .five_hour.resets_at),
          seven_day: window(.seven_day.utilization; .seven_day.resets_at),
          fable: window($f.percent; $f.resets_at)
        }},
        {ts: (now | floor), source: $source, resets: ([.cedar_ember | objects | .grants[]? | select(.resets_left > 0 and .paused != true)
          | {kind: kind, left: .resets_left, ends_at: (.ends_at | try epoch catch null)}]
          | group_by(.kind) | map({kind: .[0].kind, left: (map(.left) | add), ends_at: (map(.ends_at | values) | min)}))}
    ' 2>/dev/null)

[ -n "$LIMITS" ] && printf '%s\n' "$LIMITS" | "$(dirname "$0")/collect" >/dev/null
# overwritten on every answer, so a used or lapsed reset goes
[ -n "$RESETS" ] && [ -d "$DIR" ] && printf 'S.push(%s);\n' "$RESETS" > "$DIR/$(id -un)-resets.js"
exit 0

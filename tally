#!/bin/bash
# Adds up the tokens in the Claude Code transcripts per hour, project and model into <user>-tokens.js.
ME="$(id -un)"
DIR="${CLAUDE_LIMITS_DIR:-/Users/Shared/claude-limits}"
FILE="$DIR/$ME-tokens.js"
# one line per message and transcript, so a run reads only the transcripts changed since the last run
CACHE="$DIR/.$ME-tally.jsonl"
STAMP="$DIR/.$ME-tallied"
PROJECTS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
[ -d "$PROJECTS" ] && [ -d "$DIR" ] || exit 0

TMP="$DIR/.$ME-tally.$$"
trap 'rm -f "$TMP".*' EXIT
# taken before the find, so a transcript written during the run counts as changed next time
touch "$TMP.stamp"
# a cache from before the start folder holds the folder of each reply: read everything again, and replace the rows it put in the wrong folder
REBUILD=false
if [ -s "$CACHE" ] && ! head -1 "$CACHE" | jq -e 'has("start")' >/dev/null 2>&1; then rm -f "$STAMP"; : > "$CACHE"; REBUILD=true; fi
[ -f "$STAMP" ] && [ -f "$CACHE" ] || { rm -f "$STAMP"; : > "$CACHE"; }
find "$PROJECTS" -name '*.jsonl' > "$TMP.all"
if [ -f "$STAMP" ]; then find "$PROJECTS" -name '*.jsonl' -newer "$STAMP" > "$TMP.changed"; else cp "$TMP.all" "$TMP.changed"; fi

: > "$TMP.new"
# the folder a transcript started in: Claude Code writes a reply with the folder its own cd moved to, so the first reply can already be elsewhere
[ -s "$TMP.changed" ] && tr '\n' '\0' < "$TMP.changed" | xargs -0 grep -H -m1 '"cwd":"' 2>/dev/null \
  | jq -R -n -c '[inputs | index(":{") as $i | {(.[:$i]): (.[$i + 1:] | try fromjson.cwd catch null)}] | add // {}' > "$TMP.start"
[ -s "$TMP.changed" ] && tr '\n' '\0' < "$TMP.changed" | xargs -0 grep -H '"usage"' 2>/dev/null | jq -R -n -c --slurpfile start "$TMP.start" '
  def fields: ["input", "cache_write_5m", "cache_write_1h", "cache_read", "output"];
  [inputs | index(":{") as $i | {file: .[:$i], j: (.[$i + 1:] | try fromjson catch null)}
    | select(.j.message.usage and .j.message.id and .j.timestamp and .j.message.model != "<synthetic>")
    | .j.message.usage as $u
    | {
        file,
        sub: (.file | test("/subagents/")),
        session: (.file | sub("/subagents/.*$"; "") | sub("\\.jsonl$"; "")),
        start: ($start[0][.file] // .j.cwd),
        at: .j.timestamp,
        id: .j.message.id,
        model: .j.message.model,
        speed: (if $u.speed == "fast" then "fast" else null end),
        hour: (.j.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | . - . % 3600),
        input: ($u.input_tokens // 0),
        cache_write_5m: ($u.cache_creation.ephemeral_5m_input_tokens // $u.cache_creation_input_tokens // 0),
        cache_write_1h: ($u.cache_creation.ephemeral_1h_input_tokens // 0),
        cache_read: ($u.cache_read_input_tokens // 0),
        output: ($u.output_tokens // 0)
      }]
  # a message is logged once per content block, its usage repeated or still growing
  | group_by([.file, .id])[] | . as $g | $g[0] + (fields | map(. as $f | {($f): ($g | map(.[$f]) | max)}) | add)
' > "$TMP.new"

# a changed transcript replaces its lines, a deleted one drops them
jq -n -c --rawfile all "$TMP.all" --rawfile changed "$TMP.changed" '
  (($all | split("\n")) - ($changed | split("\n")) | map({(.): true}) | add // {}) as $keep
  | inputs | select($keep[.file])
' "$CACHE" | cat - "$TMP.new" > "$TMP.cache" && mv "$TMP.cache" "$CACHE" || exit 1

# from its file: past 1 MiB the table no longer fits into an argument, and the exec fails without a word
OLD="$FILE"; [ -f "$OLD" ] || { : > "$TMP.old"; OLD="$TMP.old"; }
jq -n -r --arg home "$HOME" --rawfile old "$OLD" --argjson rebuild "$REBUILD" '
  def rows: split("\n") | map(select(startswith("T.push(")) | ltrimstr("T.push(") | rtrimstr(");") | fromjson);
  def key: "\(.hour)|\(.project)|\(.model)|\(.speed)";
  def home: if . == null then "?" elif startswith($home) then "~" + .[($home | length):] else . end;
  def fields: ["input", "cache_write_5m", "cache_write_1h", "cache_read", "output"];

  [inputs] as $lines
  # a session belongs to the folder it started in: `cd` moves cwd, and a subagent starts wherever the session is
  | (reduce ($lines | sort_by(.sub, .at))[] as $l ({}; .[$l.session] //= $l.start)) as $project
  # a resumed session copies earlier messages into its own transcript, so a message counts once across files
  | [$lines | group_by(.id)[] | . as $g | $g[0] + (fields | map(. as $f | {($f): ($g | map(.[$f]) | max)}) | add)] as $messages
  | [$messages | map(.project = ($project[.session] | home)) | group_by(key)[]
      | . as $g | {hour: .[0].hour, project: .[0].project, model: .[0].model} + (if .[0].speed then {speed: .[0].speed} else {} end) + (fields | map(. as $f | {($f): ($g | map(.[$f]) | add)}) | add)] as $new
  # Claude Code deletes transcripts after 30 days, so a row never shrinks
  | ($new | map({(.hour | tostring): true}) | add // {}) as $hours
  # except on a rebuild: an old row may hold the tokens of a moved session, even under a folder that is also a real one, so the new rows replace every hour the transcripts still cover
  | ($old | rows | if $rebuild then map(select($hours[.hour | tostring] | not)) else . end) + $new | group_by(key)
  | map(. as $g | .[0] + (fields | map(. as $f | {($f): ($g | map(.[$f] // 0) | max)}) | add))
  | sort_by(.hour, .project, .model)[]
  | "T.push(\(tojson));"
' "$CACHE" > "$TMP.out" && [ -s "$TMP.out" ] && mv "$TMP.out" "$FILE"
mv "$TMP.stamp" "$STAMP"

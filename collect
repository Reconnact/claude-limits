#!/bin/bash
# Called by the Claude Code status line with its JSON on stdin.
ME="$(id -un)"
DIR="${CLAUDE_LIMITS_DIR:-/Users/Shared/claude-limits}"
FILE="$DIR/$ME.js"

LAST="$(tail -1 "$FILE" 2>/dev/null)"
LAST="${LAST#S.push(}"
LAST="${LAST%);}"
# only fetch-usage brings the Fable window, so it is compared with the last line that has one
LASTF="$(tail -r "$FILE" 2>/dev/null | grep -m1 '"fable"')"
LASTF="${LASTF#S.push(}"
LASTF="${LASTF%);}"
# a status line may have written a fresh reading's numbers first, unmarked, and only a fresh line lowers a window (#26)
LASTR="$(tail -r "$FILE" 2>/dev/null | grep -m1 '"fresh":true')"
LASTR="${LASTR#S.push(}"
LASTR="${LASTR%);}"

{ IFS= read -r LINE; IFS= read -r SHOWN; } < <(jq -r --arg last "$LAST" --arg lastf "$LASTF" --arg lastr "$LASTR" --arg source "$ME" '
  # resets_at moves by a few seconds between responses, a new window by hours. A limit reset keeps the window and lowers
  # the value, but a status line may repeat the old value of an idle session, so only a fresh reading from the usage endpoint lowers it
  def newer($cur; $last; $fresh):
    $cur != null and (
      $last == null
      or $cur.resets_at > $last.resets_at + 60
      or (($cur.resets_at - $last.resets_at | fabs) <= 60
          and ($cur.used_percentage > $last.used_percentage or ($fresh and $cur.used_percentage < $last.used_percentage)))
    );
  def differs($cur; $last):
    $cur != null and ($last == null or ($cur.resets_at - $last.resets_at | fabs) > 60 or $cur.used_percentage != $last.used_percentage);
  def shown: if . == null then "-" else (.used_percentage | round | tostring) end;

  def parse: try fromjson catch null | if type == "object" then . else null end;
  ($last | parse) as $l
  | ($lastf | parse) as $lf
  | ($lastr | parse) as $lr
  | (.fresh == true) as $fresh
  | .rate_limits
  | select(.five_hour != null or .seven_day != null or .fable != null)
  | (if newer(.five_hour; $l.five_hour; $fresh) or newer(.seven_day; $l.seven_day; $fresh) or newer(.fable; $lf.fable; $fresh)
        or ($fresh and (differs(.five_hour; $lr.five_hour) or differs(.seven_day; $lr.seven_day) or differs(.fable; $lr.fable)))
     then "S.push(\({ts: (now | floor), source: $source, five_hour, seven_day} + (if .fable then {fable} else {} end) + (if $fresh then {fresh: true} else {} end) | tojson));"
     else "" end),
    "\(.five_hour | shown)\t\(.seven_day | shown)"
' 2>/dev/null)

if [ -n "$SHOWN" ]; then
  [ -d "$DIR" ] || { mkdir -p "$DIR" && chmod 1777 "$DIR"; }
  [ -n "$LINE" ] && printf '%s\n' "$LINE" >> "$FILE"
  # a snapshot without values, overwritten on every check: "as of" is the last check, not the last rise
  printf 'S.push({"ts":%s,"source":"%s"});\n' "$(date +%s)" "$ME" > "$DIR/$ME-checked.js"
fi
printf '%s' "$SHOWN"

# the page cannot list a folder, so every account adds its file here once; 666 so the next account can append
if [ -f "$FILE" ] && ! grep -qx "SOURCES.push(\"$ME\");" "$DIR/sources.js" 2>/dev/null; then
  printf 'SOURCES.push("%s");\n' "$ME" >> "$DIR/sources.js"
  chmod 666 "$DIR/sources.js" 2>/dev/null
fi

# at most every 5 min: fetch-usage reads the Fable limit the status line input lacks, tally the tokens
STAMP="$DIR/.$ME-fetched"
if [ -d "$DIR" ] && [ -z "$(find "$STAMP" -mmin -5 2>/dev/null)" ]; then
  touch "$STAMP"
  { "$(dirname "$0")/fetch-usage"; "$(dirname "$0")/tally"; } </dev/null >/dev/null 2>&1 &
fi

# at most once a day the clone updates itself
UPDATED="$DIR/.$ME-updated"
if [ -d "$DIR" ] && [ -z "$(find "$UPDATED" -mtime -1 2>/dev/null)" ]; then
  touch "$UPDATED"
  "$(dirname "$0")/update" </dev/null >/dev/null 2>&1 &
fi
